paper/**/*.out
paper/**/*.blg
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
paper/**/*.toc
paper/arxiv/build/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# data/runs/, data/cache/, and data/derived/ are committed on purpose:
# `make reproduce` regenerates every number from them without API calls.
