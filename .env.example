# Copy to .env (git-ignored) and fill in. Never commit .env.
# Only needed for new paid runs; `make reproduce` uses committed outputs and needs no keys.

OPENAI_API_KEY=
GOOGLE_API_KEY=

# AWS Bedrock (Claude). Use either a named profile or explicit credentials.
AWS_REGION=us-east-1
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
